generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A person signed in with Facebook Login or Instagram Login.
model User {
  id             String    @id @default(cuid())
  provider       String // "facebook" | "instagram"
  providerUserId String
  name           String
  email          String?
  avatarUrl      String?
  sandbox        Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  sessions       Session[]
  accounts       Account[]

  @@unique([provider, providerUserId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// A connected Facebook Page or Instagram Business account.
model Account {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform    String // "instagram" | "facebook"
  name        String
  handle      String? // @handle or page name
  externalId  String // IG business account id or FB page id
  accessToken String // page/user access token (or "sandbox")
  avatarUrl   String?
  sandbox     Boolean  @default(true)
  createdAt   DateTime @default(now())
  posts       Post[]

  @@unique([userId, platform, externalId])
  @@index([userId])
}

// Simple key/value store for integration tokens and settings.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// A piece of content that can be published now or scheduled.
model Post {
  id          String    @id @default(cuid())
  accountId   String
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  platform    String // "instagram" | "facebook"
  caption     String
  hashtags    String    @default("")
  mediaUrl    String? // image URL to publish
  status      String    @default("draft") // draft | scheduled | publishing | published | failed
  scheduledAt DateTime?
  publishedAt DateTime?
  externalId  String? // remote post/media id after publish
  externalUrl String? // permalink after publish
  error       String?
  aiGenerated Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status, scheduledAt])
}
