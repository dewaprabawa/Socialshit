# --- Database (PostgreSQL) ---
# Local dev uses a local Postgres. On Vercel, set this to your hosted Postgres
# (e.g. Vercel Postgres or Neon) connection string.
DATABASE_URL="postgresql://socialshit:socialshit@localhost:5432/socialshit?schema=public"

# --- App ---
# Public base URL of the app (used for OAuth redirect + scheduler). No trailing slash.
APP_BASE_URL="http://localhost:3000"

# --- OpenAI (optional) ---
# When unset, the app falls back to a built-in template generator so you can
# still generate captions/content offline for development and demos.
OPENAI_API_KEY=""
# Model used for text generation.
OPENAI_TEXT_MODEL="gpt-4o-mini"
# Model used for image generation.
OPENAI_IMAGE_MODEL="dall-e-3"

# --- Canva Connect API (optional) ---
# From your Canva app (https://www.canva.com/developers/). Used to create and
# export editable designs for your posts. When unset, "Design with Canva" runs
# in SANDBOX mode and produces a branded placeholder design locally.
CANVA_CLIENT_ID=""
CANVA_CLIENT_SECRET=""

# --- Meta (Facebook / Instagram) Graph API (optional) ---
# From your Meta app (https://developers.facebook.com/apps).
# Enables Facebook Login, Instagram Login, Page/IG connection, and live publishing.
# When unset, login, account connection, and publishing all run in SANDBOX mode.
#
# Add these Valid OAuth Redirect URIs in the Meta app:
#   {APP_BASE_URL}/api/auth/facebook/callback
#   {APP_BASE_URL}/api/auth/instagram/callback
#
# Products: Facebook Login, Facebook Login for Business (Connect Pages),
# and Instagram API with Instagram Login.
META_APP_ID=""
META_APP_SECRET=""
# Facebook Login for Business configuration ID (User access token).
# Required to connect Pages without Invalid Scopes on consumer Facebook Login.
META_LOGIN_CONFIG_ID=""
# Graph API version.
META_GRAPH_VERSION="v21.0"

# Optional public contact shown on /privacy. If unset, the page links to GitHub issues.
PRIVACY_CONTACT_EMAIL=""
PRIVACY_CONTACT_URL=""
